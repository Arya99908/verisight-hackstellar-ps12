{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix frontend",
  "installCommand": "python3 -m pip install --no-cache-dir -r requirements.vercel.txt && npm ci --prefix frontend",
  "functions": {
    "backend/app/main.py": {
      "includeFiles": "backend/**,samples/**,frontend/dist/**",
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,**/__pycache__/**,frontend/node_modules/**}"
    }
  }
}
