{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "backend/app/main.py": {
      "includeFiles": "backend/**,samples/**,frontend/dist/**",
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,**/__pycache__/**,frontend/node_modules/**}"
    }
  }
}
